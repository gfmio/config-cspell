{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "description": "CSpell configuration for Node.js projects",
  "import": ["./typescript.json"],
  "dictionaries": [
    "node",
    "npm",
    "bash"
  ],
  "words": [
    "dirname",
    "filename",
    "argv",
    "stdin",
    "stdout",
    "stderr",
    "cwd",
    "env",
    "exitcode"
  ],
  "overrides": [
    {
      "filename": "**/.env*",
      "enabled": false
    },
    {
      "filename": "**/Dockerfile",
      "dictionaries": ["docker"]
    },
    {
      "filename": "**/.dockerignore",
      "dictionaries": ["docker"]
    }
  ]
}
