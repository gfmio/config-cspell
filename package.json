{
  "name": "@gfmio/config-cspell",
  "version": "0.0.0",
  "description": "Shareable CSpell configurations for consistent spell-checking across projects",
  "main": "cspell.json",
  "exports": {
    ".": "./cspell.json",
    "./typescript": "./typescript.json",
    "./node": "./node.json",
    "./react": "./react.json",
    "./markdown": "./markdown.json",
    "./python": "./python.json",
    "./go": "./go.json",
    "./rust": "./rust.json",
    "./java": "./java.json",
    "./cpp": "./cpp.json",
    "./vue": "./vue.json",
    "./angular": "./angular.json",
    "./nextjs": "./nextjs.json",
    "./svelte": "./svelte.json",
    "./monorepo": "./monorepo.json",
    "./strict": "./strict.json",
    "./en-us": "./en-us.json",
    "./en-gb": "./en-gb.json",
    "./css": "./css.json",
    "./docker": "./docker.json"
  },
  "files": [
    "*.json",
    "dictionaries/**/*.txt",
    "README.md"
  ],
  "keywords": [
    "cspell",
    "spell-checker",
    "config",
    "shareable-config",
    "typescript",
    "javascript",
    "react",
    "vue",
    "angular",
    "svelte",
    "nextjs",
    "node",
    "python",
    "go",
    "rust",
    "java",
    "cpp",
    "markdown",
    "docker",
    "monorepo"
  ],
  "author": "gfmio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gfmio/config-cspell.git"
  },
  "bugs": {
    "url": "https://github.com/gfmio/config-cspell/issues"
  },
  "homepage": "https://github.com/gfmio/config-cspell#readme",
  "peerDependencies": {
    "cspell": ">=8.0.0"
  },
  "devDependencies": {
    "cspell": "^8.0.0"
  },
  "scripts": {
    "test": "cspell --config cspell.json '**/*'",
    "lint": "cspell lint --config cspell.json"
  }
}
